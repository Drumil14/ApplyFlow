# Neon Postgres. Use the POOLED endpoint here (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"
# Non-pooled endpoint (same host without "-pooler"), used for prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-strong-secret"

# --- AI analysis (optional) ---
# When unset, the analyzer still works using the deterministic skill matcher;
# the AI insights panel simply shows "temporarily unavailable". Add a key to
# enable the LLM interpretation layer. Never expose this to the browser.
ANTHROPIC_API_KEY=""
# Optional model override. Defaults to claude-opus-4-8.
# ANALYZE_MODEL="claude-opus-4-8"
